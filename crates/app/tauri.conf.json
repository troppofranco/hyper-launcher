{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyper Launcher",
  "identifier": "dev.hyperlauncher.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hyper Launcher",
        "width": 1320,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://launchercontent.mojang.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
